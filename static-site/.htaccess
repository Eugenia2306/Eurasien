# Eurasien Gesellschaft static site (Apache / cPanel)
# Upload as .htaccess in the document root (same folder as index.html).

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (safe on cPanel when SSL is active)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Phase 2+: send gated brochure pages into WordPress
  RewriteRule ^mitglieder/positionen\.html$ /app/mitglieder/positionen/ [R=302,L]
  RewriteRule ^mitglieder/dossiers\.html$ /app/mitglieder/dossiers/ [R=302,L]
  RewriteRule ^mitglieder/studien\.html$ /app/mitglieder/studien/ [R=302,L]
</IfModule>

# Security headers (best-effort; host may override)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

ErrorDocument 404 /index.html
